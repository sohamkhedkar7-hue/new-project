# Leave empty to use local Ollama through the Vite development proxy.
# On Vercel, set this to the public Render API origin, e.g. https://ecoroute-api.onrender.com
VITE_API_URL=
# Optional model selection for local Ollama. The local app auto-detects an installed model when empty.
VITE_OLLAMA_MODEL=
# Optional: local Ollama server URL for the Vite development proxy.
# OLLAMA_HOST=http://127.0.0.1:11434
